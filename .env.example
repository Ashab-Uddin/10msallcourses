# ==============================================================================
# 10 Minute School Affiliate Portal — Environment Variables Template
# Copy this file to `.env.local` for local development, or configure these
# values in Vercel Project Settings -> Environment Variables for production.
# NEVER commit `.env.local` or real secret values to GitHub.
# ==============================================================================

# Public canonical site URL (used for SEO metadata, OpenGraph, sitemap, robots)
APP_URL=https://10msallcourse.com
NEXT_PUBLIC_SITE_URL=https://10msallcourse.com

# ------------------------------------------------------------------------------
# Admin Panel Authentication (REQUIRED in Vercel Production)
# Generate ADMIN_SESSION_SECRET with: openssl rand -hex 32
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-admin-password
# Optional: instead of plaintext ADMIN_PASSWORD, you may provide a salted hash
# in format `sha256:<hex>` or `scrypt:<salt>:<hex>` via ADMIN_PASSWORD_HASH
# ADMIN_PASSWORD_HASH=
ADMIN_NAME=Admin Manager
ADMIN_SESSION_SECRET=replace-with-random-64-char-hex-secret

# ------------------------------------------------------------------------------
# Persistent Production Database on Vercel (RECOMMENDED: Upstash Redis / Vercel KV)
# Add Upstash Redis from Vercel Marketplace to populate these automatically.
# Locally without these variables, data persists in `data/database.json`.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional custom Redis key prefix (default: 10ms_portal:store:v1)
# STORE_REDIS_KEY=10ms_portal:store:v1

# ------------------------------------------------------------------------------
# Cloud Image Storage for Course Thumbnails (Choose Vercel Blob OR Cloudinary)
# Option 1 (Recommended for Vercel): Vercel Blob Storage
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# Option 2: Cloudinary (used automatically if BLOB_READ_WRITE_TOKEN is not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
