# ==============================================================================
# 10 Minute School Affiliate Portal — Production Environment Variables Template
# Copy this file to `.env.local` for local development, or configure these
# values in Vercel Project Settings -> Environment Variables for production.
# NEVER commit `.env.local` or real secret values to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Canonical Site URL (SEO metadata, OpenGraph, sitemap, robots)
# ------------------------------------------------------------------------------
APP_URL=https://10msallcourse.com
NEXT_PUBLIC_SITE_URL=https://10msallcourse.com

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Supabase Auth (REQUIRED in Production)
# Obtain from Supabase Dashboard -> Project Settings -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_key
# Server-only secret key (NEVER prefix with NEXT_PUBLIC_!)
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_secret_key

# Legacy key names are also supported automatically if your Supabase project uses them:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. ImageKit Cloud Storage (REQUIRED for Admin Course Thumbnail Uploads)
# Obtain from ImageKit Dashboard -> Developer Options -> API Keys
# ------------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=public_replace_with_imagekit_public_key
# Server-only private key (NEVER prefix with NEXT_PUBLIC_!)
IMAGEKIT_PRIVATE_KEY=private_replace_with_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_UPLOAD_FOLDER=/10ms-courses

# ------------------------------------------------------------------------------
# 4. Optional Local / Non-Supabase Admin Auth Fallback
# Used ONLY when Supabase Auth is not configured (e.g. offline local dev).
# Generate ADMIN_SESSION_SECRET with: openssl rand -hex 32
# ------------------------------------------------------------------------------
# ADMIN_EMAIL=admin@10msallcourse.com
# ADMIN_PASSWORD=replace-with-strong-admin-password
# ADMIN_PASSWORD_HASH=scrypt:<salt>:<hex>
# ADMIN_NAME=Admin Manager
# ADMIN_SESSION_SECRET=replace-with-random-64-char-hex-secret
