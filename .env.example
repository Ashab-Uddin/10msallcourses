# ============================================================================
# 10msallcourse.com — Environment Variables Template (.env.example)
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local` to GitHub.
# ============================================================================

# --- 1. Supabase PostgreSQL & Auth (Required for your existing Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Legacy Supabase key names (only needed if your project uses anon/service_role naming instead of publishable/secret)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- 2. Site URL & SEO Configuration ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 3. ImageKit Cloud Upload (Optional — keep blank until ImageKit integration phase) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_UPLOAD_FOLDER=/10ms-courses
IMAGEKIT_BOOKS_FOLDER=/10ms-books

# --- 4. Local Dev Fallback Admin Login (Optional — only used when Supabase Auth keys above are NOT set) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Site Admin
ADMIN_SESSION_SECRET=
